{
  "consumers": {
    "opencode": { "scope": "full" },
    "openclaw": { "scope": "full" },
    "gemini": { "scope": "channels", "channels": ["memory"], "writable": ["memory"] }
  },
  "tokens": {
    "<generated-token-1>": "opencode",
    "<generated-token-2>": "openclaw",
    "<generated-token-3>": "gemini"
  },
  "channels": {
    "github": { "enabled": true, "ttl_seconds": 300, "timeout_seconds": 10 },
    "memory": { "enabled": true, "ttl_seconds": 900, "timeout_seconds": 10, "url": "http://127.0.0.1:8000/mcp" }
  }
}
